{
  "name": "dsh-godot-stack",
  "version": "0.1.0",
  "description": "Godot Codely stack: godot-codely-lite preset, godot skills and godot-mcp-server, provisioned into the DSH home on boot.",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "godot-codely": "./cli/godot-codely.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "bridge",
    "cli",
    "skills",
    "godot-stack",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhhh124hhhh/godot-codely-desktop.git",
    "directory": "packages/dsh-godot-stack"
  },
  "keywords": [
    "dsh-plugin",
    "godot",
    "game-dev",
    "mcp"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
