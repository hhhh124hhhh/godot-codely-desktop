{
  "name": "dsh-godot-stack",
  "version": "0.1.0",
  "description": "Godot Codely stack: godot-codely-lite preset, godot skills and godot-mcp-server, provisioned into the DSH home on boot.",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "godot-codely": "./cli/godot-codely.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mcp-agent": "./mcp-agent.mjs",
    "./governance": "./governance/index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "desktop-api.mjs",
    "data-home.mjs",
    "copy-bundled-directory.mjs",
    "memory-root.mjs",
    "mcp-agent.mjs",
    "mcp-runtime.mjs",
    "governance",
    "bridge",
    "cli",
    "skills",
    "godot-stack",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhhh124hhhh/godot-codely-desktop.git",
    "directory": "packages/dsh-godot-stack"
  },
  "keywords": [
    "dsh-plugin",
    "godot",
    "game-dev",
    "mcp"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.9"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["dsh-desktop-workbenches", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-workspace"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
